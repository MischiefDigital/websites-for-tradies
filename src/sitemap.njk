---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set pages = collections.all | sort(false, false, "url") -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in pages %}
{%- if item.data.sitemapExclude !== true %}
{#- pageDates.json first: real git commit dates, snapshotted by tools/page-dates.js
    and committed, because Vercel's shallow clone has no per-file history to read
    at build time. Front-matter `updated` is the fallback and the manual override;
    a live git lookup covers a brand-new template not yet in the snapshot. Still
    omits <lastmod> entirely rather than guessing. -#}
{%- set lastmod = pageDates[item.inputPath | dateKey] or (item.data.updated | isoDay) or (item.inputPath | gitLastmod) %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
{%- if lastmod %}
    <lastmod>{{ lastmod }}</lastmod>
{%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
