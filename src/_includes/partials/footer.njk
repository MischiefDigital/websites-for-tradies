<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="wft-logo small" aria-label="WFT Websites for Tradies — home">
          {% include "partials/logo.njk" %}
        </a>
        <p class="footer-pitch">Done-for-you websites for New Zealand tradies. {{ site.priceDisplay }} flat, live in {{ site.buildDays }}, backed by the Jobs In {{ site.guaranteeDays }} guarantee.</p>
        <p class="footer-contact"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>

      {%- for col in nav.footer %}
      <div class="footer-col">
        <h2 class="footer-heading">{{ col.heading }}</h2>
        <ul>
          {%- for link in col.links %}
          <li><a href="{{ link.url }}">{{ link.text }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>

    <div class="footer-bottom">
      <p>Serving Kiwi tradies across Aotearoa New Zealand · Based in {{ site.addressLocality }}</p>
      <p>© WFT — Websites for Tradies. All rights reserved.</p>
    </div>
  </div>
</footer>
