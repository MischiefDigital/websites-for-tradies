{#
  Demo build 1 — "Redwrench Plumbing", a fictional emergency plumber.
  Self-contained on purpose: its own head, styles, nav and footer, so it reads
  as a separate client site rather than a WFT page. Fictional-name and
  no-Google-presence checks done 31 Aug 2026 (Companies Register + web search).
  Rules for every demo page: robots noindex, visible DEMO banner, phone
  numbers that don't connect (555 range), forms disabled.
#}
<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/inter-latin.woff2" crossorigin />
  <style>
    @font-face{font-family:Inter;font-style:normal;font-weight:100 900;font-display:swap;src:url(/assets/fonts/inter-latin.woff2) format('woff2')}
    :root{--navy:#0B1F3A;--navy2:#132C4F;--red:#D7263D;--red-dark:#B01C30;--paper:#F5F7FA;--ink:#15202B;--muted:#5A6B7E;--line:#DDE4EC;--white:#FFF}
    *{box-sizing:border-box}
    body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);background:var(--white);line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}
    .wrap{width:min(1060px,calc(100% - 40px));margin:0 auto}
    .demo-banner{background:#FFD84D;color:#1a1a1a;font-size:13px;font-weight:600;text-align:center;padding:9px 16px}
    .demo-banner a{text-decoration:underline;font-weight:800}
    .rw-top{background:var(--navy);color:var(--white)}
    .rw-topline{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 0;font-size:13px;color:rgba(255,255,255,.75);border-bottom:1px solid rgba(255,255,255,.12)}
    .rw-topline strong{color:var(--white)}
    .rw-nav{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 0}
    .rw-logo{font-size:22px;font-weight:900;letter-spacing:-.02em}
    .rw-logo span{color:var(--red)}
    .rw-logo small{display:block;font-size:10px;font-weight:700;letter-spacing:.18em;color:rgba(255,255,255,.65)}
    .rw-links{display:flex;gap:20px;flex-wrap:wrap;font-size:14px;font-weight:600}
    .rw-links a{color:rgba(255,255,255,.85);padding:4px 0}
    .rw-links a[aria-current]{color:var(--white);box-shadow:0 2px 0 var(--red)}
    .call-btn{display:inline-flex;align-items:center;gap:8px;background:var(--red);color:var(--white);font-weight:800;padding:12px 20px;border-radius:8px;white-space:nowrap;font-size:15px}
    .call-btn:hover{background:var(--red-dark)}
    .call-btn.big{padding:18px 34px;font-size:1.15rem}
    .call-btn.ghost{background:transparent;border:1.5px solid rgba(255,255,255,.4)}
    .rw-hero{position:relative;background:var(--navy);color:var(--white);overflow:hidden}
    .rw-hero-img{position:absolute;inset:0;background-position:center;background-size:cover;opacity:.38}
    .rw-hero-grad{position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,31,58,.92) 30%,rgba(11,31,58,.5))}
    .rw-hero-inner{position:relative;padding:84px 0 92px;max-width:640px}
    .rw-hero h1{margin:0 0 18px;font-size:clamp(2rem,5.4vw,3.4rem);line-height:1.08;letter-spacing:-.02em;font-weight:900}
    .rw-hero h1 em{color:#FF6B7D;font-style:normal}
    .rw-hero p{color:rgba(255,255,255,.85);font-size:1.1rem;margin:0 0 28px}
    .rw-badges{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}
    .rw-badge{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:7px 13px;color:rgba(255,255,255,.85)}
    section{padding:64px 0}
    .sec-paper{background:var(--paper)}
    .kicker{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin:0 0 10px}
    h2{margin:0 0 16px;font-size:clamp(1.5rem,3.4vw,2.1rem);line-height:1.15;letter-spacing:-.015em;font-weight:900}
    .lead{color:var(--muted);max-width:640px;margin:0 0 34px}
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
    .card{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:24px}
    .card h3{margin:0 0 8px;font-size:1.05rem;font-weight:800}
    .card p{margin:0 0 14px;font-size:.95rem;color:var(--muted)}
    .card .go{color:var(--red);font-weight:800;font-size:.9rem}
    .steps{counter-reset:s;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
    .step{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:22px}
    .step::before{counter-increment:s;content:counter(s);display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;background:var(--navy);color:#fff;font-weight:800;border-radius:8px;margin-bottom:12px;font-size:14px}
    .step h3{margin:0 0 6px;font-size:1rem;font-weight:800}
    .step p{margin:0;font-size:.92rem;color:var(--muted)}
    .fee-table{width:100%;border-collapse:collapse;background:var(--white);border:1px solid var(--line);border-radius:12px;overflow:hidden}
    .fee-table th{background:var(--navy);color:#fff;text-align:left;font-size:13px;letter-spacing:.05em;text-transform:uppercase;padding:12px 16px}
    .fee-table td{padding:13px 16px;border-top:1px solid var(--line);font-size:.95rem}
    .fee-table td:last-child{font-weight:800;white-space:nowrap}
    .note{font-size:.85rem;color:var(--muted);margin-top:12px}
    .split{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
    .split img{border-radius:14px;border:1px solid var(--line)}
    .checklist{list-style:none;margin:0 0 22px;padding:0}
    .checklist li{padding-left:28px;position:relative;margin-bottom:10px}
    .checklist li::before{content:"✓";position:absolute;left:0;color:var(--red);font-weight:900}
    .cta-band{background:var(--navy);color:#fff;text-align:center;padding:64px 0}
    .cta-band h2{color:#fff}
    .cta-band p{color:rgba(255,255,255,.75);max-width:520px;margin:0 auto 26px}
    .prose-block p{max-width:680px;color:#39485a}
    .prose-block h3{margin:30px 0 8px;font-size:1.1rem;font-weight:800}
    .rw-footer{background:var(--navy2);color:rgba(255,255,255,.7);padding:44px 0;font-size:14px}
    .rw-footer .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
    .rw-footer strong{color:#fff}
    .rw-footer a{text-decoration:underline}
    .callbar{display:none}
    @media(max-width:860px){.split{grid-template-columns:1fr}.rw-links{display:none}}
    @media(max-width:720px){
      body{padding-bottom:68px}
      .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--red);color:#fff;align-items:center;justify-content:center;gap:10px;padding:16px;font-weight:900;font-size:1.05rem;box-shadow:0 -4px 16px rgba(0,0,0,.25)}
      .rw-hero-inner{padding:56px 0 64px}
    }
  </style>
</head>
<body>
  <div class="demo-banner">DEMONSTRATION BUILD — Redwrench Plumbing is a fictional business. Phone numbers don't connect and forms are disabled. <a href="/example-builds/">See why this demo exists →</a></div>

  <div class="rw-top">
    <div class="wrap rw-topline"><span>Serving <strong>Wellington · Hutt Valley · Porirua</strong></span><span>Open <strong>24 hours, 7 days</strong></span></div>
    <nav class="wrap rw-nav" aria-label="Redwrench navigation">
      <a class="rw-logo" href="/demos/redwrench-plumbing/">RED<span>WRENCH</span><small>EMERGENCY PLUMBING</small></a>
      <div class="rw-links">
        <a href="/demos/redwrench-plumbing/blocked-drains/"{% if page.url == "/demos/redwrench-plumbing/blocked-drains/" %} aria-current="page"{% endif %}>Blocked drains</a>
        <a href="/demos/redwrench-plumbing/hot-water/"{% if page.url == "/demos/redwrench-plumbing/hot-water/" %} aria-current="page"{% endif %}>Hot water</a>
        <a href="/demos/redwrench-plumbing/emergency-plumber/"{% if page.url == "/demos/redwrench-plumbing/emergency-plumber/" %} aria-current="page"{% endif %}>After-hours</a>
        <a href="/demos/redwrench-plumbing/contact/"{% if page.url == "/demos/redwrench-plumbing/contact/" %} aria-current="page"{% endif %}>Contact</a>
      </div>
      <a class="call-btn" href="tel:+6445550199">☎ 04 555 0199</a>
    </nav>
  </div>

  {% block content %}{% endblock %}

  <footer class="rw-footer">
    <div class="wrap">
      <div>
        <strong>Redwrench Plumbing</strong> · Wellington, Hutt Valley &amp; Porirua<br />
        Certifying Plumber · Registered with the Plumbers, Gasfitters and Drainlayers Board
      </div>
      <div>
        A fictional demonstration business.<br />
        Website by <a href="https://www.websitesfortradies.co.nz/">WFT — Websites for Tradies</a>
      </div>
    </div>
  </footer>

  <a class="callbar" href="tel:+6445550199">☎ CALL NOW — 04 555 0199</a>
</body>
</html>
