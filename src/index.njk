{% extends "layouts/base.njk" %}

{% block headExtra %}
  {# Preload matches the CSS breakpoint so phones never fetch the 262KB art.
     fetchpriority="high" because this is the LCP element — Lighthouse flags
     its absence explicitly. Without it the preload is discovered but queued
     behind other requests, which is what left LCP at 3.4s. #}
  <link rel="preload" as="image" href="/Images/hero-tradie-900.webp" type="image/webp" fetchpriority="high" media="(max-width: 768px)" />
  <link rel="preload" as="image" href="/Images/hero-tradie.webp" type="image/webp" fetchpriority="high" media="(min-width: 769px)" />
{% endblock %}

{% block schema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "{{ site.url }}/#service",
        "name": "Tradie Website Package",
        "serviceType": "Website design for trade businesses",
        "provider": { "@id": "{{ site.url }}/#business" },
        "description": "A complete 5+ page tradie website including copywriting, local SEO, a .nz domain, {{ site.hostingIncluded }} with SSL, and Google Business Profile setup. Live in {{ site.buildDays }}. Ongoing hosting and local SEO continue under the Get Found Plan at {{ site.planPriceDisplay }} from day {{ site.planStartsDay }}, with no lock-in.",
        "areaServed": { "@type": "Country", "name": "New Zealand" },
        "audience": {
          "@type": "BusinessAudience",
          "name": "New Zealand tradespeople and trade businesses"
        },
        "offers": {
          "@type": "Offer",
          "price": "{{ site.price }}",
          "priceCurrency": "{{ site.currency }}",
          "availability": "https://schema.org/InStock",
          "url": "{{ site.url }}/#offer",
          "seller": { "@id": "{{ site.url }}/#organization" }
        }
      }
    ]
  }
  </script>
{#
